# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual envs
.venv/
venv/
.env
.env.*

# Build / dist (Python packaging output — NOT eng/ Mode B harness)
dist/
build/
*.egg

# Mode B (eng/) work noise — keep AGENTS/templates tracked
eng/sessions/**/verify_log.jsonl
eng/sessions/**/.cache/
apps/*/.local/

# Eng fixtures: regenerate with scripts/sync_eng_fixtures.py (do not version bulk trees)
eng/fixtures/archive/research/
eng/fixtures/archive/outcomes/
eng/fixtures/archive/catalog/*.sqlite
eng/fixtures/archive/catalog/*.sqlite-*

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
err.log
out.log

# Nested package git metadata (track sources in monorepo, not nested repos)
**/.git/
**/.git.bak-nested/

# Research session trees (large: filings, prices, charts, raw dumps).
# Keep on disk under archive/research/; do not version in git.
# Catalog indexes (JSON, jsonl, schema_version, SQLite) are rebuildable.
archive/research/
archive/outcomes/
archive/library/
archive/comparisons/
archive/research_jobs/
archive/.grok_jobs.lock
eng/fixtures/archive/library/**
archive/catalog/*.json
archive/catalog/*.jsonl
archive/catalog/schema_version
archive/catalog/*.sqlite
archive/catalog/*.sqlite-*

# Optional local MCP/tool caches and large binary dumps
**/data/raw_sec/
**/data/transcripts/
*.pdf
*.png
!harness/**/*.png

# Playwright MCP dump dir (default tool path)
.playwright-mcp/

# Agent-chosen scratch
/tmp/

# Local Damodaran library (hubs, extracts, EPUBs). Not a Mode A runtime input.
/ref/
