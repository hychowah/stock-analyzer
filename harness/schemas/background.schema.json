{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "background.schema.json",
  "title": "Background Research (light contract)",
  "description": "Merged by the main agent from the Phase 0 research swarm. Structure enforced; content is qualitative.",
  "type": "object",
  "additionalProperties": true,
  "required": ["ticker", "rounds"],
  "properties": {
    "ticker": { "type": "string" },
    "rounds": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["topic", "findings", "sources"],
        "properties": {
          "round": { "type": "integer" },
          "topic": { "type": "string" },
          "findings": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "sources": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    }
  }
}
