{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "audit.schema.json",
  "title": "Audit Result (light contract)",
  "description": "Written by the Phase 5 audit agent. Cross-checks reports against registry data and verifies the justification contract.",
  "type": "object",
  "additionalProperties": true,
  "required": ["verdict", "checks"],
  "properties": {
    "verdict": { "type": "string", "enum": ["PASS", "FAIL"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "status"],
        "properties": {
          "check": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "skipped"] },
          "detail": { "type": "string" }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "description", "location"],
        "properties": {
          "severity": { "type": "string", "enum": ["critical", "major", "minor"] },
          "description": { "type": "string" },
          "location": { "type": "string", "description": "file and section/line where the issue appears." },
          "resolution": { "type": "string", "description": "Filled after the fix loop." }
        }
      }
    }
  }
}
