{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "run_manifest.schema.json",
  "title": "Research Run Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "run_id", "product", "ticker", "session_date", "paths", "status"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "run_id": { "type": "string" },
    "product": { "type": "string" },
    "ticker": { "type": "string" },
    "session_date": { "type": "string" },
    "created_at": { "type": "string" },
    "completed_at": { "type": "string" },
    "harness_version": {
      "type": "string",
      "description": "Intentional Mode A product version from harness/VERSION (semver)"
    },
    "harness_spec": { "type": "string", "description": "Major family label e.g. v2" },
    "session_key": { "type": "string" },
    "paths": { "type": "object" },
    "status": { "type": "string" },
    "audit_verdict": { "type": ["string", "null"] },
    "immutable": { "type": "boolean" },
    "layout": { "type": "string", "description": "archive | legacy" },
    "experiment_id": { "type": ["string", "null"] },
    "experiment_label": { "type": ["string", "null"] },
    "replicate": { "type": ["integer", "null"] },
    "harness_git_sha": {
      "type": "string",
      "description": "git rev-parse HEAD at scaffold/finalize, or 'unknown'"
    },
    "harness_dirty": { "type": ["boolean", "null"] },
    "agents_md_sha256": { "type": ["string", "null"] },
    "research_agents_sha256": { "type": ["string", "null"] },
    "prompts_sha256": { "type": ["string", "null"] },
    "version_file_sha256": { "type": ["string", "null"] },
    "orchestrator_model": {
      "type": ["string", "null"],
      "description": "Required for new scaffolds (non-null). Stamp at scaffold via --orchestrator-model; null only for pre-2.4.0 legacy. Never invent late."
    },
    "default_subagent_model": {
      "type": ["string", "null"],
      "description": "Defaults to orchestrator_model when omitted at scaffold."
    },
    "model_map": { "type": ["object", "null"] },
    "temperature": { "type": ["number", "null"] },
    "seed": { "type": ["string", "number", "null"] },
    "notes": { "type": ["string", "null"] }
  }
}
