{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "session_acceptance.schema.json",
  "title": "Session Acceptance Checklist (light contract)",
  "description": "Machine surface for structural/provenance readiness. Written by check_session.py --write-acceptance. Not financial truth — audit owns truth.",
  "type": "object",
  "additionalProperties": true,
  "required": ["ticker", "session_date", "generated_at", "overall", "checks"],
  "properties": {
    "ticker": { "type": "string" },
    "session_date": { "type": "string" },
    "generated_at": { "type": "string" },
    "overall": {
      "type": "string",
      "enum": ["PASS", "FAIL", "PARTIAL"]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "status"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["PASS", "FAIL", "SKIPPED"]
          },
          "detail": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "notes": { "type": "string" }
  }
}
