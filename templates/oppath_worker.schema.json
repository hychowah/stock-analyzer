{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "oppath_worker.schema.json",
  "title": "Phase 1d worker extract (gather only)",
  "description": "1d_rev / 1d_ind / 1d_ol write one of these under registry/raw/oppath_{rev,ind,ol}.json. Evidence only — no 8-year forecast, no FV.",
  "type": "object",
  "additionalProperties": true,
  "required": ["ticker", "session_date", "lens", "findings"],
  "properties": {
    "ticker": { "type": "string" },
    "session_date": { "type": "string" },
    "lens": {
      "type": "string",
      "enum": ["revenue_growth", "industry_trend", "operating_leverage"]
    },
    "compute_script": { "type": "string" },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "sources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sector_remap": { "type": "string" },
    "not_applicable": { "type": "boolean" },
    "not_applicable_rationale": { "type": "string" }
  }
}
