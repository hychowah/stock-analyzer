{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eng/feature_brief.schema.json",
  "title": "EngFeatureBrief",
  "type": "object",
  "required": ["goal", "work_type", "success_criteria", "write_denylist"],
  "properties": {
    "goal": { "type": "string", "minLength": 1 },
    "non_goals": { "type": "array", "items": { "type": "string" } },
    "work_type": {
      "type": "string",
      "enum": ["W1", "W2", "W3", "W4", "W5"]
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "write_allowlist": { "type": "array", "items": { "type": "string" } },
    "write_denylist": { "type": "array", "items": { "type": "string" } },
    "verify_commands": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
