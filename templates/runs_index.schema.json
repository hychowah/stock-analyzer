{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "runs_index.schema.json",
  "title": "Archive Runs Catalog Index",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "updated_at", "runs"],
  "properties": {
    "schema_version": { "type": "integer" },
    "updated_at": { "type": "string" },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run_id", "ticker", "session_date", "path"],
        "properties": {
          "run_id": { "type": "string" },
          "ticker": { "type": "string" },
          "session_date": { "type": "string" },
          "path": { "type": "string" },
          "audit_verdict": { "type": ["string", "null"] },
          "asof_price": { "type": ["number", "null"] },
          "fv_base": { "type": ["number", "null"] },
          "margin_of_safety_pct": { "type": ["number", "null"] },
          "primary_sector": { "type": ["string", "null"] },
          "region": { "type": ["string", "null"] },
          "has_prediction_snapshot": { "type": "boolean" },
          "has_outcomes": { "type": "boolean" }
        }
      }
    }
  }
}
