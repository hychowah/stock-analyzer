{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "library_manifest.schema.json",
  "title": "Ticker document library manifest",
  "description": "Index of reusable primary documents under archive/library/<TICKER>/.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "ticker", "documents"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "ticker": { "type": "string" },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "sha256", "kind"],
        "properties": {
          "id": { "type": "string" },
          "sha256": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": [
              "annual",
              "interim",
              "earnings_release",
              "supplement",
              "transcript",
              "presentation",
              "other"
            ]
          },
          "form": { "type": ["string", "null"] },
          "fiscal_period": { "type": ["string", "null"] },
          "filing_date": { "type": ["string", "null"] },
          "needs_label": { "type": "boolean" },
          "conversion_status": { "type": ["string", "null"] },
          "files": { "type": "object" }
        }
      }
    }
  }
}
