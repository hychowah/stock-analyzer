{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "session_isolation.schema.json",
  "title": "Session Isolation Policy",
  "description": "Cross-session valuation isolation; intra-session sharing remains allowed.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "mode", "session_key", "rules"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "mode": {
      "type": "string",
      "enum": ["isolated", "context_meta_only", "compare_after"]
    },
    "ticker": { "type": "string" },
    "session_date": { "type": "string" },
    "session_key": { "type": "string" },
    "created_at": { "type": "string" },
    "allow_prior_session_keys": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Only for non-valuation meta or post-audit compare; empty under isolated"
    },
    "rules": {
      "type": "object",
      "required": ["intra_session_share", "prior_valuation_as_input"],
      "properties": {
        "intra_session_share": { "type": "boolean" },
        "prior_valuation_as_input": { "type": "boolean" },
        "prior_for_post_audit_compare": { "type": "boolean" }
      }
    },
    "notes": { "type": "string" }
  }
}
