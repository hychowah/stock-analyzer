{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spawns.schema.json",
  "title": "Specialist Subagent Spawn Ledger",
  "description": "Orchestrator-written log of spawn_subagent launches. Required on harness >= 2.20.0 when specialist artifacts exist or a specialist is marked complete. This is process telemetry, not cryptographic proof of the Task API.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "ticker", "session_date", "spawns"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "ticker": { "type": "string" },
    "session_date": { "type": "string" },
    "updated_at": { "type": "string" },
    "spawns": {
      "type": "array",
      "items": { "$ref": "#/definitions/spawn" }
    }
  },
  "definitions": {
    "spawn": {
      "type": "object",
      "additionalProperties": true,
      "required": ["subagent_id", "phase_id", "status"],
      "properties": {
        "subagent_id": { "type": "string", "minLength": 1 },
        "phase_id": { "type": "string", "minLength": 1 },
        "tool": { "type": "string", "description": "Usually spawn_subagent" },
        "subagent_type": { "type": "string", "description": "explore | coder | general-purpose" },
        "status": {
          "type": "string",
          "enum": ["launched", "returned", "failed"]
        },
        "launched_at": { "type": "string" },
        "returned_at": { "type": ["string", "null"] },
        "fail_reason": { "type": ["string", "null"] }
      }
    }
  }
}
