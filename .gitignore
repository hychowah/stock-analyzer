# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual envs
.venv/
venv/
.env
.env.*

# Build / dist
dist/
build/
*.egg

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
err.log
out.log

# Nested package git metadata (track sources in monorepo, not nested repos)
**/.git/
**/.git.bak-nested/

# Research session trees (large: filings, prices, charts, raw dumps).
# Keep on disk under archive/research/; do not version in git.
# Catalog JSON indexes + archive/README.md remain tracked; SQLite is rebuildable.
archive/research/
archive/outcomes/
archive/catalog/*.sqlite
archive/catalog/*.sqlite-*

# Optional local MCP/tool caches and large binary dumps
**/data/raw_sec/
**/data/transcripts/
*.pdf
*.png
!harness/**/*.png
